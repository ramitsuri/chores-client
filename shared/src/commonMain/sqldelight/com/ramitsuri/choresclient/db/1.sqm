import com.ramitsuri.choresclient.model.enums.ActiveStatus;
import com.ramitsuri.choresclient.model.enums.RepeatUnit;
import kotlin.Boolean;
import kotlin.time.Instant;
import kotlinx.datetime.LocalDateTime;

CREATE TABLE IF NOT EXISTS TaskOutboxEntity (
    id TEXT NOT NULL PRIMARY KEY,
    type TEXT NOT NULL,
    taskId TEXT,
    name TEXT,
    description TEXT,
    dueDateTime TEXT AS LocalDateTime,
    repeatValue INTEGER,
    repeatUnit INTEGER AS RepeatUnit,
    repeatEndDateTime TEXT AS LocalDateTime,
    houseId TEXT,
    memberId TEXT,
    rotateMember INTEGER AS Boolean,
    status INTEGER AS ActiveStatus,
    createdDate INTEGER AS Instant NOT NULL
);
